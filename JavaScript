          </td>
          <td>
            <span class="badge ${record.Status_Aktif === 'Aktif' ? 'badge-success' : 'badge-secondary'}">
              ${record.Status_Aktif}
            </span>
          </td>
          <td>
            <div class="btn-group btn-group-sm" role="group">
              <button class="btn btn-outline-primary" onclick="editGuruModal('${record.ID}')">Edit</button>
