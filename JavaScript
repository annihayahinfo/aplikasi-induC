      <li><a class="nav-link" href="#" onclick="navigateTo('dashboard')"><i class="bi bi-speedometer2"></i> <span>Dashboard</span></a></li>
      <li><a class="nav-link" href="#" onclick="navigateTo('review')"><i class="bi bi-clipboard-check"></i> <span>Review</span></a></li>
      <li><a class="nav-link" href="#" onclick="navigateTo('data-guru')"><i class="bi bi-people"></i> <span>Data Guru</span></a></li>
      <li><a class="nav-link" href="#" onclick="navigateTo('laporan')"><i class="bi bi-graph-up"></i> <span>Laporan</span></a></li>
      <li><a class="nav-link" href="#" onclick="navigateTo('pengaturan')"><i class="bi bi-gear"></i> <span>Pengaturan</span></a></li>
    `,
    'TU': `
      <li><a class="nav-link" href="#" onclick="navigateTo('dashboard')"><i class="bi bi-speedometer2"></i> <span>Dashboard</span></a></li>
      <li><a class="nav-link" href="#" onclick="navigateTo('review')"><i class="bi bi-clipboard-check"></i> <span>Review</span></a></li>
      <li><a class="nav-link" href="#" onclick="navigateTo('data-guru')"><i class="bi bi-people"></i> <span>Data Guru</span></a></li>
      <li><a class="nav-link" href="#" onclick="navigateTo('laporan')"><i class="bi bi-graph-up"></i> <span>Laporan</span></a></li>
