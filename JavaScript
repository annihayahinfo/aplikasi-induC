 * PENGATURAN
 * ============================================================
 */

function loadPengaturan() {
  google.script.run
    .withSuccessHandler((response) => {
      if (response.success) {
        const config = response.data;
        document.getElementById('configAppName').value = config.appName || '';
        document.getElementById('configLogoUrl').value = config.logoUrl || '';
        document.getElementById('configWhatsappProvider').value = config.whatsappProvider || 'twilio';
        document.getElementById('configWhatsappKey').value = config.whatsappApiKey ? '••••••' : '';
      }
    })
    .withFailureHandler(onError)
    .getAllConfig();

  // Load akun pengguna (untuk Admin Super)
  if (currentRole === 'Admin Super') {
    google.script.run
      .withSuccessHandler((response) => {
        if (response.success) {
          const records = response.data;
          let html = '';
          records.forEach(record => {
            html += `
              <tr>
                <td>${record.Email}</td>
                <td>${record.Nama_Lengkap}</td>
                <td><span class="badge badge-info">${record.Role}</span></td>
                <td><span class="badge ${record.Status === 'Aktif' ? 'badge-success' : 'badge-secondary'}">${record.Status}</span></td>
              </tr>
            `;
          });
          document.getElementById('akunTable').innerHTML = html;
        }
      })
      .withFailureHandler(onError)
      .getAllAkunPengguna();
  }
}

function saveConfig() {
  const appName = document.getElementById('configAppName').value;
  const logoUrl = document.getElementById('configLogoUrl').value;
  const whatsappProvider = document.getElementById('configWhatsappProvider').value;
  const whatsappKey = document.getElementById('configWhatsappKey').value;

  // Save each config item
  google.script.run.setConfig('appName', appName);
  google.script.run.setConfig('logoUrl', logoUrl);
  google.script.run.setConfig('whatsappProvider', whatsappProvider);
  
  if (whatsappKey && whatsappKey !== '••••••') {
    google.script.run.setConfig('whatsappApiKey', whatsappKey);
  }

  showToast('Pengaturan berhasil disimpan', 'success');
}

/**
 * ============================================================
 * UTILITIES
 * ============================================================
 */

function showToast(message, type = 'info') {
  const toastId = 'toast-' + Date.now();
  const html = `
    <div id="${toastId}" class="toast show" role="alert">
      <div class="toast-header">
        <strong class="me-auto">
          ${type === 'success' ? '✅' : type === 'danger' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️'}
          ${type.charAt(0).toUpperCase() + type.slice(1)}
        </strong>
        <button type="button" class="btn-close" onclick="document.getElementById('${toastId}').remove()"></button>
      </div>
      <div class="toast-body">${message}</div>
    </div>
  `;

  document.getElementById('toastContainer').insertAdjacentHTML('beforeend', html);

  // Auto remove after 5 seconds
  setTimeout(() => {
    const el = document.getElementById(toastId);
    if (el) el.remove();
  }, 5000);
}

function onError(error) {
  console.error('❌ Error:', error);
  showToast('Error: ' + (error.message || error), 'danger');
}

function toggleDarkMode() {
  const currentTheme = document.documentElement.getAttribute('data-theme');
  const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', newTheme);
  localStorage.setItem('theme', newTheme);
}

// Webcam cleanup
window.addEventListener('beforeunload', () => {
  if (webcamStream) {
    webcamStream.getTracks().forEach(track => track.stop());
  }
});

// Date input event listeners
document.addEventListener('DOMContentLoaded', () => {
  const reviewDate = document.getElementById('reviewDate');
  if (reviewDate) {
    reviewDate.addEventListener('change', loadReviewAbsensi);
  }

  const guruSearch = document.getElementById('guruSearch');
  if (guruSearch) {
    guruSearch.addEventListener('input', filterDataGuru);
  }
});

function filterDataGuru() {
  const searchTerm = document.getElementById('guruSearch').value.toLowerCase();
  const rows = document.querySelectorAll('#guruTable tr');
  
  rows.forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(searchTerm) ? '' : 'none';
  });
}
