/**
 * ============================================================
 * LAPORAN
 * ============================================================
 */

function loadLaporan() {
  const bulan = parseInt(document.getElementById('laporanBulan').value);
  const tahun = parseInt(document.getElementById('laporanTahun').value);

  google.script.run
    .withSuccessHandler(onLaporanSuccess)
    .withFailureHandler(onError)
    .getLaporanBulanan(bulan, tahun);
}

function onLaporanSuccess(response) {
  if (response.success) {
    const data = response.data;
    const chartData = data.chartData;

    // Draw Kehadiran Chart
    drawKehadiranChart(chartData.labels, chartData.kehadiranData);

    // Draw Lembur Chart
    drawLemburChart(chartData.labels, chartData.lemburData);

    // Fill table
    let html = '';
    data.laporan.forEach(item => {
      html += `
        <tr>
          <td><strong>${item.nama}</strong></td>
          <td>${item.totalKehadiran}</td>
          <td>${item.totalHariLibur}</td>
          <td>${item.totalJamLembur.toFixed(1)} jam</td>
        </tr>
      `;
    });
    document.getElementById('laporanTable').innerHTML = html || '<tr><td colspan="4" class="text-center text-muted">Tidak ada data</td></tr>';

    showToast('Laporan berhasil dimuat', 'success');
  }
}

function drawKehadiranChart(labels, data) {
  const ctx = document.getElementById('kehadiranChart');
  if (!ctx) return;

  if (chartInstances.kehadiran) {
    chartInstances.kehadiran.destroy();
  }

  chartInstances.kehadiran = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [{
        label: 'Total Kehadiran',
        data: data,
        backgroundColor: '#1e3a8a',
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: { beginAtZero: true }
      }
    }
  });
}

function drawLemburChart(labels, data) {
  const ctx = document.getElementById('lemburChart');
  if (!ctx) return;

  if (chartInstances.lembur) {
    chartInstances.lembur.destroy();
  }

  chartInstances.lembur = new Chart(ctx, {
    type: 'bar',
    data: {
