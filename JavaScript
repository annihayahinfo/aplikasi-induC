    document.getElementById('guruTable').innerHTML = html;
  }
}

function openAddGuruModal() {
  document.getElementById('formAddGuru').reset();
  bootstrap.Modal.getOrCreateInstance(document.getElementById('addGuruModal')).show();
}

function submitAddGuru() {
  const form = document.getElementById('formAddGuru');
  const formData = new FormData(form);
  
  const guru = {
    Nama: formData.get('Nama'),
    NIP: formData.get('NIP'),
    Email: formData.get('Email'),
    No_HP: formData.get('No_HP'),
    Status_Aktif: 'Aktif'
  };

  google.script.run
    .withSuccessHandler((response) => {
      if (response.success) {
        showToast('Guru berhasil ditambahkan', 'success');
        bootstrap.Modal.getInstance(document.getElementById('addGuruModal')).hide();
        loadDataGuru();
      } else {
        showToast('Error: ' + response.message, 'danger');
      }
    })
    .withFailureHandler(onError)
    .addGuru(guru);
}

function deleteGuru(id) {
  if (confirm('Yakin ingin menghapus guru ini?')) {
    google.script.run
      .withSuccessHandler((response) => {
        if (response.success) {
          showToast('Guru berhasil dihapus', 'success');
          loadDataGuru();
        }
      })
      .withFailureHandler(onError)
      .deleteGuru(id);
  }
}

