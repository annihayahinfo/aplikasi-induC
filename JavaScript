      html = '<tr><td colspan="8" class="text-center text-muted">Belum ada data guru.</td></tr>';
    } else {
      html = records.map(record => `
        <tr>
          <td><small>${record.ID?.slice(0, 8)}</small></td>
          <td>
            <div class="d-flex align-items-center gap-2">
