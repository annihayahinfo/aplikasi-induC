/**
 * ============================================================
 * NAVIGATION & ROUTING
 * ============================================================
 */

function navigateTo(sectionId) {
  // Hide all sections
  document.querySelectorAll('.content-section').forEach(el => {
    el.classList.remove('active');
  });

  // Show selected section
  const section = document.getElementById(`section-${sectionId}`);
  if (section) {
    section.classList.add('active');
    currentSection = sectionId;

    // Update sidebar active state
    document.querySelectorAll('.nav-link').forEach(link => {
      link.classList.remove('active');
    });
    event.target.closest('.nav-link')?.classList.add('active');

    // Update page title
    document.getElementById('pageTitle').textContent = 
      sectionId.charAt(0).toUpperCase() + sectionId.slice(1).replace('-', ' ');

    // Load section data
    loadSectionData(sectionId);

    // Close sidebar on mobile
    if (window.innerWidth < 768) {
      document.getElementById('sidebar').style.display = 'none';
    }
  }
}

function toggleSidebar() {
  const sidebar = document.getElementById('sidebar');
  sidebar.style.display = sidebar.style.display === 'none' ? 'block' : 'none';
}

function loadSectionData(sectionId) {
  switch (sectionId) {
    case 'dashboard':
      loadDashboard();
      break;
    case 'absensi':
      initWebcam();
      break;
    case 'review':
      loadReviewAbsensi();
      break;
    case 'data-guru':
      loadDataGuru();
      break;
    case 'hari-libur':
      loadHariLibur();
      break;
    case 'laporan':
      // Will load when user clicks "Tampilkan Laporan"
      break;
    case 'pengaturan':
      loadPengaturan();
      break;
  }
}

/**
 * ============================================================
 * DASHBOARD
 * ============================================================
 */

function loadDashboard() {
  google.script.run
    .withSuccessHandler(onDashboardSuccess)
    .withFailureHandler(onError)
    .getDashboardData();
}

function onDashboardSuccess(response) {
  if (response.success) {
    const data = response.data;

    // Update KPI Cards
    const kpiHtml = `
      <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
          <div class="stat-icon"><i class="bi bi-people"></i></div>
          <div class="stat-value">${data.totalGuru}</div>
          <div class="stat-label">Total Guru</div>
          <small class="text-muted">Terdaftar</small>
        </div>
      </div>
      <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
          <div class="stat-icon"><i class="bi bi-check-circle" style="color: #10b981;"></i></div>
          <div class="stat-value" style="color: #10b981;">${data.berhasilHariIni}</div>
          <div class="stat-label">Berhasil Hari Ini</div>
          <small class="text-muted">Terverifikasi</small>
        </div>
      </div>
      <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
          <div class="stat-icon"><i class="bi bi-exclamation-circle" style="color: #ef4444;"></i></div>
          <div class="stat-value" style="color: #ef4444;">${data.gagalHariIni}</div>
          <div class="stat-label">Gagal Hari Ini</div>
          <small class="text-muted">Perlu Review</small>
        </div>
      </div>
      <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
          <div class="stat-icon"><i class="bi bi-calendar-event"></i></div>
          <div class="stat-value">${data.upcomingHolidays.length}</div>
          <div class="stat-label">Upcoming Holidays</div>
          <small class="text-muted">Mendatang</small>
        </div>
      </div>
    `;
    document.getElementById('kpiContainer').innerHTML = kpiHtml;

    // Update Recent Activity (max 5)
    const activityRows = data.insights.slice(0, 5).map(insight => `
      <tr>
        <td colspan="3" class="text-muted small">${insight}</td>
      </tr>
    `).join('');
    document.getElementById('recentActivityList').innerHTML = activityRows || '<tr><td colspan="3" class="text-center text-muted">Tidak ada aktivitas</td></tr>';

    // Update Insights List
    const insightsList = data.insights.map(insight => `
      <li>${insight}</li>
    `).join('');
    document.getElementById('insightsList').innerHTML = insightsList;

    // Daily Chart (dummy data for now)
    drawDailyChart([95, 92, 90, 88, 85, 80, 78]);
  }
}

function drawDailyChart(data) {
  const ctx = document.getElementById('dailyChart');
  if (!ctx) return;

  // Destroy previous chart
  if (chartInstances.daily) {
    chartInstances.daily.destroy();
  }

  chartInstances.daily = new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
      datasets: [{
        label: 'Success Rate (%)',
        data: data,
        borderColor: '#1e3a8a',
        backgroundColor: 'rgba(30, 58, 138, 0.1)',
        tension: 0.4,
        fill: true,
        pointRadius: 4,
        pointBackgroundColor: '#1e3a8a'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: {
          beginAtZero: true,
          max: 100,
          ticks: {
            callback: function(value) { return value + '%'; }
          }
        }
      }
    }
  });
}

/**
 * ============================================================
 * ABSENSI — WEBCAM & VERIFICATION
 * ============================================================
 */

function initWebcam() {
  const video = document.getElementById('webcamVideo');
  
  if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } })
      .then(stream => {
        webcamStream = stream;
        video.srcObject = stream;
        console.log('✅ Webcam initialized');
      })
      .catch(err => {
        console.error('❌ Webcam error:', err);
        showToast('Tidak dapat mengakses kamera. Periksa izin browser.', 'danger');
      });
  } else {
    showToast('Browser tidak mendukung webcam', 'danger');
  }
}

function verifyFace() {
  // Simulasi verifikasi wajah
  const confidence = Math.floor(Math.random() * 30) + 80; // 80-110%
  const isMatch = confidence >= 95;

  document.getElementById('faceDetectionStatus').textContent = isMatch ? '✅ Cocok' : '❌ Tidak Cocok';
  document.getElementById('faceConfidence').textContent = confidence;
  document.getElementById('faceDetected').textContent = isMatch ? '✅ Yes' : '❌ No';
  document.getElementById('confidenceLevel').textContent = confidence;

  if (isMatch) {
    // Record attendance
    google.script.run
      .withSuccessHandler(onAbsensiSuccess)
      .withFailureHandler(onError)
      .recordAbsensi(
        currentUser.email,
        currentUser.nama,
        'Wajah',
        'Berhasil',
        `Match ${confidence}%`
      );
  } else {
    showToast('Verifikasi gagal. Coba lagi.', 'warning');
  }
}

function verifyFingerprint() {
  // Simulasi verifikasi sidik jari
  const isMatch = Math.random() > 0.3; // 70% success rate

  if (isMatch) {
    google.script.run
      .withSuccessHandler(onAbsensiSuccess)
      .withFailureHandler(onError)
      .recordAbsensi(
        currentUser.email,
        currentUser.nama,
        'Sidik Jari',
        'Berhasil',
        'Sidik jari cocok'
      );
  } else {
    showToast('Verifikasi sidik jari gagal. Coba wajah atau ulangi.', 'warning');
  }
}

function onAbsensiSuccess(response) {
  if (response.success) {
    showToast('✅ ' + response.message, 'success');
    console.log('Absensi record:', response.data);
    
    // Show confirmation modal
    setTimeout(() => {
      showAbsensiConfirmation(response.data);
    }, 1000);
  } else {
    showToast('❌ Error: ' + response.message, 'danger');
  }
}

function showAbsensiConfirmation(data) {
  const html = `
    <div class="alert alert-success" role="alert">
      <h5><i class="bi bi-check-circle"></i> Verifikasi Berhasil</h5>
      <p><strong>Nama:</strong> ${data.Nama_Guru}</p>
      <p><strong>Tanggal:</strong> ${data.Tanggal}</p>
      <p><strong>Jam Masuk:</strong> ${data.Jam_Masuk}</p>
      <p><strong>Status:</strong> ${data.Status_Verifikasi}</p>
      <p class="mb-0 small text-muted">Notifikasi WhatsApp telah dikirim ke nomor terdaftar.</p>
    </div>
  `;
  // Display in alert area or modal
  showToast('Absensi tercatat: ' + data.Nama_Guru, 'success');
}

/**
 * ============================================================
 * REVIEW ABSENSI
 * ============================================================
 */

function loadReviewAbsensi() {
  const tanggal = document.getElementById('reviewDate').value;
  console.log('Loading review for:', tanggal);

  google.script.run
    .withSuccessHandler(onReviewAbsensiSuccess)
    .withFailureHandler(onError)
    .getAbsensiByDate(tanggal);
}

function onReviewAbsensiSuccess(response) {
  if (response.success) {
    const records = response.data;
    let html = '';

    if (records.length === 0) {
      html = '<tr><td colspan="7" class="text-center text-muted">Belum ada data absensi untuk tanggal ini.</td></tr>';
    } else {
      html = records.map(record => `
        <tr>
          <td><strong>${record.Nama_Guru}</strong></td>
          <td>${record.Tanggal}</td>
          <td>${record.Jam_Masuk}</td>
          <td>${record.Jam_Keluar || '--'}</td>
          <td>
            <span class="badge" style="background: ${record.Tipe_Verifikasi === 'Wajah' ? '#0ea5e9' : '#f59e0b'};">
              ${record.Tipe_Verifikasi}
            </span>
          </td>
          <td>
            <span class="badge ${record.Status_Verifikasi === 'Berhasil' ? 'badge-success' : 'badge-danger'}">
              ${record.Status_Verifikasi}
            </span>
          </td>
          <td>
            <button class="btn btn-sm btn-outline-primary" onclick="editAbsensi('${record.ID_Absensi}')">
              Detail
            </button>
          </td>
        </tr>
      `).join('');
    }

    document.getElementById('reviewTable').innerHTML = html;
  }
}

function editAbsensi(idAbsensi) {
  // Store ID and open override modal
  window.currentAbsensiId = idAbsensi;
  bootstrap.Modal.getOrCreateInstance(document.getElementById('overrideModal')).show();
}

function submitOverride() {
  const status = document.getElementById('overrideStatus').value;
  const catatan = document.getElementById('overrideCatatan').value;

  google.script.run
    .withSuccessHandler((response) => {
      if (response.success) {
        showToast('Status absensi berhasil diubah', 'success');
        bootstrap.Modal.getInstance(document.getElementById('overrideModal')).hide();
        loadReviewAbsensi();
      }
    })
    .withFailureHandler(onError)
    .overrideAbsensiStatus(window.currentAbsensiId, status, catatan);
}

