<script>
/**
 * ============================================================
 * JAVASCRIPT — Sistem Absensi Kantor
 * SPA Routing, Backend Integration, Charts, Webcam
 * ============================================================
 */

// ─── Global State ─── 
let currentUser = null;
let currentRole = 'Guest';
let currentSection = 'dashboard';
let chartInstances = {};
let webcamStream = null;

// ─── Init ─── 
document.addEventListener('DOMContentLoaded', () => {
  console.log('🚀 Aplikasi dimulai...');
  
  // Set default bulan laporan
  const today = new Date();
  document.getElementById('reviewDate').valueAsDate = today;
  document.getElementById('laporanBulan').value = today.getMonth() + 1;
  document.getElementById('laporanTahun').value = today.getFullYear();

  // Setup dark mode
  const savedTheme = localStorage.getItem('theme') || 'light';
  document.documentElement.setAttribute('data-theme', savedTheme);
  document.getElementById('darkModeToggle').checked = savedTheme === 'dark';

  // Get current user & init UI
  google.script.run
    .withSuccessHandler(onGetCurrentUserSuccess)
    .withFailureHandler(onError)
    .getCurrentUserRole();
});

/**
 * ============================================================
 * USER & AUTH
 * ============================================================
 */

function onGetCurrentUserSuccess(response) {
  if (response.success) {
    currentUser = response.data;
    currentRole = response.data.role;
    console.log('✅ User logged in:', currentUser);

    // Update UI
    document.getElementById('userNameDisplay').textContent = currentUser.nama || currentUser.email;
    
    // Setup menu based on role
    setupMenuByRole(currentRole);

    // Load initial dashboard
    loadDashboard();

    // Hide loading
    document.getElementById('loadingOverlay').style.display = 'none';
  } else {
    showToast('Error: ' + response.message, 'danger');
  }
}

